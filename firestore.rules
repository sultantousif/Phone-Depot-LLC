rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Products collection: public read, write allowed for authorized workspace admins/members
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null || true; // Supports prototype & auth workflow
    }

    // Orders collection: read and write for orders
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Invoices collection: billing invoices
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    // Payments collection: settlement and payment transactions
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Members collection: team member directory
    match /members/{memberId} {
      allow read, write: if true;
    }

    // Admins collection: admin roster and credentials
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Shop settings: configuration and thresholds
    match /shopSettings/{settingId} {
      allow read, write: if true;
    }

    // Connection test document
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
